{"atom_id": "SNAP2024Q4_000", "text": "Financials In Q3, total revenue was $1.37 billion, up 15% year-over-year and 11% quarter-over-quarter.", "source": "8-K", "time": 0, "tags": ["earnings", "financials"], "metadata": {"severity": 0.085, "extracted_by": "financial_results", "source_class": "primary_filing"}, "published_at": 0}
